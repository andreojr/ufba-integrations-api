# Mesmo client OAuth já usado pro Classroom (console.cloud.google.com,
# API "Google Classroom" habilitada). O secret fica só aqui, nunca é
# distribuído pra quem consome a API.
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=

# URL pública deste serviço depois do deploy (ex: https://ufba-integrations-api.up.railway.app).
# Precisa bater com o redirect_uri cadastrado no Google Cloud Console
# (<PUBLIC_BASE_URL>/classroom/oauth/callback).
PUBLIC_BASE_URL=
